# Copy this file to .env.local and fill in real values.
# Generate values with the commands shown in comments.

# JWT signing secret — min 48 chars Base64
# openssl rand -base64 48
JWT_SECRET=REPLACE_ME

# AES-256-GCM key for notification_outbox payload encryption — 32-byte Base64
# openssl rand -base64 32
OUTBOX_PAYLOAD_KEY=REPLACE_ME

# Fixed destination inbox for the Help / Contact-us feature
# (POST /api/v1/support/contact). Blank => endpoint returns 503.
# Locally any value works — Mailpit (http://localhost:8025) captures all mail.
SUPPORT_EMAIL=support@beautica.local

# Turbosms SMS provider (Phase 13.1) — Bearer token for api.turbosms.ua.
# Blank => SMS disabled; a send attempt throws SmsDeliveryException (no startup failure).
# Optional: TURBOSMS_SENDER_NAME (default Beautica), TURBOSMS_BASE_URL.
TURBOSMS_TOKEN=
